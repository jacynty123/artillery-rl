{
  "experiment_metadata": {
    "title": "Reinforcement Learning for Optimal Firing Timing Decisions in Anti-Aircraft Fire Control Systems",
    "version": "paper2-v1.0",
    "description": "Authoritative parameter snapshot for Paper 2 experiments, including environment, reward function, network architecture, and evaluation protocol.",
    "companion_manuscript": "docs/paper2_rl_methodology/paper2_rl_methodology.tex"
  },
  "environment": {
    "tracking_duration_s": 10.0,
    "max_episode_steps": 50,
    "dt_measurement_s": 0.5,
    "projectile_velocity_m_s": 800.0,
    "initial_target_z_m": 50.0,
    "measurement_noise_std_m": [1.0, 1.0, 1.0],
    "process_noise_std_m_s2": [0.1, 0.1, 0.1],
    "simulated_hp_ramp": {
      "formula": "base_hp * (0.3 + 0.7 * min(1.0, t_elapsed / 5.0))",
      "ramp_time_constant_s": 5.0,
      "ramp_floor": 0.3,
      "ramp_scale": 0.7
    }
  },
  "state_representation": {
    "state_dimension": 14,
    "features": [
      {"index": 0, "symbol": "s0", "name": "Current estimated range (normalized)", "scale": "R_t / 5000.0"},
      {"index": 1, "symbol": "s1", "name": "Initial estimated range (normalized)", "scale": "R_0 / 5000.0"},
      {"index": 2, "symbol": "s2", "name": "Range-rate (normalized)", "scale": "R_dot / 100.0"},
      {"index": 3, "symbol": "s3", "name": "Target length", "scale": "L_t (m)"},
      {"index": 4, "symbol": "s4", "name": "Target width", "scale": "W_t (m)"},
      {"index": 5, "symbol": "s5", "name": "Target height", "scale": "H_t (m)"},
      {"index": 6, "symbol": "s6", "name": "Estimated velocity vx (normalized)", "scale": "v_x / 100.0"},
      {"index": 7, "symbol": "s7", "name": "Estimated velocity vy (normalized)", "scale": "v_y / 100.0"},
      {"index": 8, "symbol": "s8", "name": "Estimated velocity vz (normalized)", "scale": "v_z / 100.0"},
      {"index": 9, "symbol": "s9", "name": "Normalized time remaining", "scale": "t_rem / T_max"},
      {"index": 10, "symbol": "s10", "name": "Current hit probability", "scale": "p_hit in [0, 1]"},
      {"index": 11, "symbol": "s11", "name": "Initial hit probability", "scale": "p_hit,0 in [0, 1]"},
      {"index": 12, "symbol": "s12", "name": "Clamped Kalman covariance trace", "scale": "min(1.0, Tr(P_t) / 1000.0)"},
      {"index": 13, "symbol": "s13", "name": "Target heading angle (normalized)", "scale": "psi_t / pi"}
    ]
  },
  "action_space": {
    "action_dimension": 2,
    "actions": {
      "0": "HOLD (continue tracking and filtering)",
      "1": "FIRE (commit to battery engagement, terminates episode)"
    }
  },
  "network_architecture": {
    "type": "Multi-Layer Perceptron (MLP)",
    "input_dim": 14,
    "hidden_layers": [128, 64, 32],
    "output_dim": 2,
    "activations": ["ReLU", "ReLU", "ReLU", "Linear"],
    "total_trainable_parameters": 18690,
    "theoretical_flops": 37380
  },
  "reward_function": {
    "firing_rewards": {
      "excellent": {"threshold": 0.70, "reward": 100.0},
      "good": {"threshold": 0.60, "reward": 80.0},
      "acceptable": {"threshold": 0.50, "reward": 60.0},
      "fair": {"threshold": 0.45, "reward": 20.0},
      "failure": {"threshold": 0.00, "reward": -30.0}
    },
    "hold_penalties": {
      "excellent": {"threshold": 0.70, "penalty": -5.0},
      "good": {"threshold": 0.60, "penalty": -2.0},
      "acceptable": {"threshold": 0.50, "penalty": -0.5},
      "shaping_below_acceptable": {"threshold": 0.00, "formula": "5.0 * (p_hit,t - p_hit,t-1) - 0.1"}
    },
    "time_and_safety": {
      "time_efficiency_bonus": 30.0,
      "progressive_time_penalty_factor": -100.0,
      "late_firing_threshold_step": 30,
      "late_firing_max_penalty": -20.0,
      "fast_scenario_hp_gain": 500.0,
      "fast_scenario_late_penalty": 500.0,
      "fast_scenario_step_horizon": 50,
      "plateau_window_steps": 10,
      "plateau_slope_threshold": 0.002,
      "plateau_hold_multiplier": 5.0,
      "plateau_fire_bonus": 50.0,
      "timeout_penalty": -40.0,
      "timeout_high_hp_threshold": 0.60
    }
  },
  "curriculum_training": {
    "total_phases": 4,
    "timesteps_per_phase": 10000,
    "batch_size": 32,
    "buffer_size": 50000,
    "gamma": 0.99,
    "learning_rate": 0.0005,
    "target_update_freq": 500,
    "learning_starts": 1000,
    "epsilon_start": 1.0,
    "epsilon_end": 0.01,
    "epsilon_decay_steps": 2000,
    "eval_interval": 100,
    "phase_mastery_criteria": {
      "phase_1": {"avg_hp": 0.65, "min_hp": 0.60, "max_step_ratio": 0.40},
      "phase_2": {"avg_hp": 0.55, "min_hp": 0.50, "max_step_ratio": 0.50},
      "phase_3": {"avg_hp": 0.45, "min_hp": 0.40, "max_step_ratio": 0.60},
      "phase_4": {"avg_hp": 0.50, "min_hp": 0.40, "max_step_ratio": 0.70}
    }
  },
